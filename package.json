{
  "name": "pixelgrid-noise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:packages": "pnpm --filter @tooldroid/pixel-field build",
    "publish": "pnpm run build:packages && pnpm --filter @tooldroid/pixel-field publish --access public",
    "publish:dry-run": "pnpm run build:packages && pnpm --filter @tooldroid/pixel-field publish --access public --dry-run",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tooldroid/pixel-field": "workspace:*",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
