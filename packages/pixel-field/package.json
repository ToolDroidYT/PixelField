{
  "name": "@tooldroid/pixel-field",
  "version": "1.0.0",
  "description": "Full-bleed animated pixel noise field for React, rendered on a canvas.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "canvas",
    "noise",
    "animation",
    "pixel",
    "background",
    "fbm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToolDroidYT/PixelField.git",
    "directory": "packages/pixel-field"
  },
  "homepage": "https://github.com/ToolDroidYT/PixelField#readme",
  "bugs": {
    "url": "https://github.com/ToolDroidYT/PixelField/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test test/",
    "bench": "pnpm run build && node bench/frame-cost.mjs",
    "bench:noise": "pnpm run build && node bench/fbm-cost.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  }
}
